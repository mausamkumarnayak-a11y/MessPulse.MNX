# MessPulse Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

PROJECT_NAME="MessPulse"
ENVIRONMENT="development"
DEBUG=True

# Security & Authentication
# In production, generate a secure secret with: openssl rand -hex 32
SECRET_KEY="messpulse-development-secret-key-change-in-production-random-token"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local development default: SQLite
DATABASE_URL="sqlite:///./messpulse.db"
# PostgreSQL Production / Docker default:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/messpulse"

# Mess Pilot Configuration
DEFAULT_MESS_ID="mess_ashoka_01"
DEFAULT_MESS_NAME="Ashoka Hall of Residence Mess"
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_CUTOFF_MINUTES=60
MINIMUM_RATING_SAMPLE_SIZE=5

# CORS Settings (JSON string or comma-separated URLs)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000"
